{
  "name": "shared-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/src",
  "prefix": "app",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:ui"
  ],
  "targets": {
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": [
          "libs/shared/ui/**/*.ts",
          "libs/shared/ui/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "web:build:development",
        "providersFile": "apps/web/src/testing/test-providers.ts",
        "tsConfig": "apps/web/tsconfig.spec.json",
        "include": [
          "**/*.spec.ts"
        ]
      }
    },
    "storybook": {
      "executor": "@storybook/angular-vite:start-storybook",
      "options": {
        "port": 6006,
        "configDir": "libs/shared/ui/.storybook",
        "compodoc": false,
        "zoneless": true,
        "styles": [
          "libs/shared/ui/styles/_tokens.css",
          "libs/shared/ui/styles/_overlay.css"
        ]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular-vite:build-storybook",
      "outputs": [
        "{options.outputDir}"
      ],
      "options": {
        "outputDir": "dist/storybook/shared-ui",
        "configDir": "libs/shared/ui/.storybook",
        "compodoc": false,
        "zoneless": true,
        "styles": [
          "libs/shared/ui/styles/_tokens.css",
          "libs/shared/ui/styles/_overlay.css"
        ]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
